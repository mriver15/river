DEEPSEEK_API_KEY=sk-...
RIVER_MODEL=deepseek-flash   # or deepseek-v4-pro (smarter, pricier)
AGENT_NAME=River
THINK_INTERVAL_MS=8000       # pause between "thought cycles"
MAX_CYCLES_PER_HOUR=240      # cap on thought cycles (doubled off-peak)
MAX_TOKENS_PER_HOUR=1500000  # soft cap on tokens (doubled off-peak). River slows as it fills, and dozes only at 100%
# OFFPEAK_MULTIPLIER=2         # DeepSeek is half price off-peak, so the budget stretches
# PEAK_HOURS_UTC=1-4,6-10      # weekdays only; weekends are all off-peak
MAX_STEPS_PER_CYCLE=0
PORT=8787
# TAVILY_API_KEY=            # optional: better web_search (default is DuckDuckGo HTML)
# MOCK_LLM=1                 # scripted brain, no API calls (for testing the world/UI)

# --- fully local brain (Ollama or any OpenAI-compatible server) ---
# LLM_BASE_URL=http://localhost:11434/v1
# RIVER_MODEL=gpt-oss:20b     # must support tool calling

# --- semantic memory (local embeddings via Ollama: `ollama pull mxbai-embed-large`) ---
# EMBED_MODEL=mxbai-embed-large   # default. nomic-embed-text also works. Changing it re-embeds all memories automatically
# EMBED_BASE_URL=http://localhost:11434
# EMBED_DISABLED=1               # keyword-only memory search

# --- world stimuli ---
# AMBIENT_RATE=1                 # 0 = off, 2 = twice as eventful

# RIVER_TEMPERATURE=1.3          # sampling temperature for River's decisions (default API value is 1.0)

# --- budget (DeepSeek is half price off-peak: 01:00-04:00 and 06:00-10:00 UTC weekdays are PEAK) ---
# Defaults: 1.5M tokens/h and 240 cycles/h at peak; doubled off-peak (OFFPEAK_MULTIPLIER).
