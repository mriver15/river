{
  "name": "river-world",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "audit": "tsx scripts/audit-nondeterminism.ts --write",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "baseline": "tsx scripts/baseline.ts",
    "verify:replay": "tsx scripts/verify-replay.ts",
    "replay": "tsx scripts/replay.ts",
    "crash-test": "tsx scripts/crash-test.ts",
    "soak": "tsx scripts/soak-replay.ts",
    "behaviour": "tsx scripts/behaviour-report.ts",
    "slots": "tsx scripts/slots.ts",
    "restart-test": "tsx scripts/restart-test.ts",
    "gallery:shots": "tsx scripts/gallery-shots.ts",
    "experiment": "tsx scripts/experiment.ts",
    "tv:shot": "tsx scripts/tv-shot.ts",
    "replay:serve": "tsx scripts/replay-serve.ts",
    "replay:serve-test": "tsx scripts/replay-serve-test.ts",
    "protocol-test": "tsx scripts/protocol-test.ts",
    "unattended": "tsx scripts/unattended.ts",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "make:legacy-db": "tsx scripts/make-legacy-db.ts"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
